{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-monitoring-system.local/schemas/reviewer_finding.json",
  "title": "ReviewerFinding",
  "description": "One individual reviewer's finding; it is not the aggregated ReviewerResult.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "reviewer_id",
    "role",
    "model_name",
    "prompt_version",
    "verdict",
    "cited_step_id",
    "evidence_quote",
    "confidence"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "reviewer_id": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "type": "string",
      "enum": ["reasoning", "tool_use", "task_completion", "risk"]
    },
    "model_name": {
      "type": ["string", "null"]
    },
    "prompt_version": {
      "type": ["string", "null"]
    },
    "verdict": {
      "type": "string",
      "enum": ["pass", "needs_attention", "fail"]
    },
    "cited_step_id": {
      "type": ["integer", "null"],
      "minimum": 1
    },
    "evidence_quote": {
      "type": ["string", "null"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}
