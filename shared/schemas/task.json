{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-monitoring-system.local/schemas/task.json",
  "title": "TaskRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "text",
    "tier",
    "split",
    "tags",
    "oracle"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "tier": {
      "type": "string",
      "enum": ["easy", "medium", "hard"]
    },
    "split": {
      "type": "string",
      "enum": ["development", "regression", "held_out"]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_reference", "expected_outcome"],
      "properties": {
        "rule_reference": {
          "type": "string",
          "minLength": 1
        },
        "expected_outcome": {
          "description": "Deterministic oracle result; it is not generated by a reviewer or LLM."
        }
      }
    }
  }
}
