{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-monitoring-system.local/schemas/patch_contract.json",
  "title": "PatchContract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "patch_id",
    "target_config_version",
    "target_config_hash",
    "source_finding_ids",
    "objective",
    "resource_limits",
    "rollback_condition",
    "affected_task_tags",
    "edit_operations",
    "generated_code"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "patch_id": {
      "type": "string",
      "minLength": 1
    },
    "target_config_version": {
      "type": "string",
      "minLength": 1
    },
    "target_config_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "source_finding_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "comparison", "target"],
      "properties": {
        "metric": {
          "type": "string",
          "minLength": 1
        },
        "comparison": {
          "type": "string",
          "enum": ["greater_than", "at_least", "less_than", "at_most"]
        },
        "target": {
          "type": "number"
        },
        "unit": {
          "type": ["string", "null"]
        }
      }
    },
    "resource_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latency_ms_cap", "cost_usd_cap"],
      "properties": {
        "latency_ms_cap": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "cost_usd_cap": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "rollback_condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "comparison", "threshold"],
      "properties": {
        "metric": {
          "type": "string",
          "minLength": 1
        },
        "comparison": {
          "type": "string",
          "enum": ["less_than", "at_most", "greater_than", "at_least"]
        },
        "threshold": {
          "type": "number"
        }
      }
    },
    "affected_task_tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "edit_operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operation", "section", "path"],
        "properties": {
          "operation": {
            "type": "string",
            "enum": ["add", "replace", "remove"]
          },
          "section": {
            "type": "string",
            "enum": [
              "instructions",
              "tool_routing_rules",
              "guardrails",
              "retrieval_settings"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "value": {}
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "operation": {
                  "enum": ["add", "replace"]
                }
              },
              "required": ["operation"]
            },
            "then": {
              "required": ["value"]
            },
            "else": {
              "not": {
                "required": ["value"]
              }
            }
          }
        ]
      }
    },
    "generated_code": {
      "const": false,
      "description": "Executable or model-generated code is prohibited."
    }
  }
}
