# Copy to .env in the project root. Every value is optional; defaults shown.

APP_NAME=Agent Monitoring System
# SQLAlchemy URL. Default is a SQLite file at data/agent_monitoring.db
# DATABASE_URL=sqlite:///./data/agent_monitoring.db
# Comma-separated origins allowed to call the API from a browser
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Also write each trace/review as JSON under data/executions and data/evaluation
PERSIST_JSON_FILES=true
# Reviewer latency check budget (milliseconds)
LATENCY_BUDGET_MS=5000
